---
import { faqItems } from "../utils/schema";
---

<section id="faq" class="border-t border-hairline bg-paper-deep/40">
  <div class="container-px section-pad">
    <div class="max-w-[60ch]">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Quick answers
      </h2>
      <p class="mt-3 text-ink-soft leading-relaxed">
        The questions people ask before booking a festival trip to China.
      </p>
    </div>

    <div class="mt-10 max-w-[820px] space-y-3">
      {faqItems.map((item) => (
        <details class="group rounded-field border border-hairline bg-white/60">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 [&::-webkit-details-marker]:hidden">
            <span class="font-medium text-ink">{item.q}</span>
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-hairline text-ink transition-transform duration-200 group-open:rotate-45">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </span>
          </summary>
          <p class="border-t border-hairline px-5 pb-5 pt-4 leading-relaxed text-ink-soft">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
