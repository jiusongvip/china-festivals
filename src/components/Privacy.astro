<section id="privacy" class="border-t border-hairline bg-paper-deep/40">
  <div class="container-px section-pad">
    <div class="max-w-[68ch]">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Privacy & contact
      </h2>
      <p class="mt-3 text-ink-soft leading-relaxed">
        This site is a static travel guide. Here is how we handle your data.
      </p>

      <div class="mt-8 space-y-6">
        <div>
          <h3 class="font-display text-lg font-semibold text-ink">No personal data collected</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            We run no analytics, no tracking cookies, and no sign-up forms, and we never
            ask for your name or email. There is nothing to log in to and nothing to
            store.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-ink">Third-party links</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            Where we link to our sister city guides, each site has its own privacy
            policy. Once you leave this page, that site's policy applies.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-ink">Contact</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            Questions or corrections? Email
            <a
              href="mailto:hello@festivals-china.com"
              class="font-medium text-vermilion hover:underline"
            >
              hello@festivals-china.com
            </a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
