---
import { festivals } from "../data/festivals";

const crowdLabel = {
  low: "Low crowds",
  medium: "Moderate crowds",
  high: "Very crowded",
};

const byMonth = [...festivals].sort(
  (a, b) => a.month - b.month || a.name.localeCompare(b.name)
);
---

<section class="border-t border-hairline">
  <div class="container-px section-pad">
    <div class="max-w-[60ch]">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        All 22 festivals at a glance
      </h2>
      <p class="mt-3 text-ink-soft leading-relaxed">
        The full 2027 calendar in one table, sorted by month. Tap any festival to jump
        straight to its guide.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto rounded-field border border-hairline bg-white/60">
      <table class="w-full min-w-[760px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-hairline">
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Festival</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">2027 dates</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Lunar date</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Where to go</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Crowds</th>
          </tr>
        </thead>
        <tbody>
          {byMonth.map((f, i) => (
            <tr class:list={[i !== 0 && "border-t border-hairline"]}>
              <td class="px-5 py-3.5">
                <a href={`#${f.slug}`} class="font-medium text-ink hover:text-vermilion">
                  {f.name}
                  <span class="ml-1.5 text-xs text-ink-soft">{f.nameZh}</span>
                </a>
              </td>
              <td class="whitespace-nowrap px-5 py-3.5 font-medium text-vermilion">{f.date2027}</td>
              <td class="px-5 py-3.5 text-ink-soft">{f.lunarDate ?? "—"}</td>
              <td class="px-5 py-3.5 text-ink-soft">
                {f.bestCities.map((c, j) => (j > 0 ? `, ${c.name}` : c.name))}
              </td>
              <td class="px-5 py-3.5 text-ink-soft">{crowdLabel[f.crowd]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-soft">
      2027 Gregorian dates are reference values for lunar festivals; the lunar date is
      the anchor that never shifts.
    </p>
  </div>
</section>
