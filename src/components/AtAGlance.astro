---
const rows = [
  { name: "Spring Festival", slug: "spring-festival", month: "Feb", crowd: "Very crowded", best: "Fireworks, family energy", cost: 3 },
  { name: "Mid-Autumn", slug: "mid-autumn-festival", month: "Sep", crowd: "Moderate", best: "Food, a calm full moon", cost: 2 },
  { name: "Water Splashing", slug: "water-splashing-festival", month: "Apr", crowd: "Very crowded", best: "Fun in warm weather", cost: 3 },
  { name: "Dragon Boat", slug: "dragon-boat-festival", month: "Jun", crowd: "Moderate", best: "Races, zongzi", cost: 2 },
  { name: "Harbin Ice", slug: "harbin-ice-festival", month: "Jan", crowd: "Very crowded", best: "Ice and light spectacle", cost: 3 },
  { name: "Shoton", slug: "shoton-festival", month: "Aug", crowd: "High", best: "Quiet ritual", cost: 1 },
];
---

<section class="border-t border-hairline">
  <div class="container-px section-pad">
    <div class="max-w-[60ch]">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Six festivals at a glance
      </h2>
      <p class="mt-3 text-ink-soft leading-relaxed">
        The quick reference if you already have a month or a budget in mind.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto rounded-field border border-hairline bg-white/60">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-hairline">
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Festival</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Month</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Crowds</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Best for</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">Cost</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class:list={[i !== 0 && "border-t border-hairline"]}>
              <td class="px-5 py-3.5">
                <a href={`#${r.slug}`} class="font-medium text-ink hover:text-vermilion">
                  {r.name}
                </a>
              </td>
              <td class="px-5 py-3.5 text-ink-soft">{r.month}</td>
              <td class="px-5 py-3.5 text-ink-soft">{r.crowd}</td>
              <td class="px-5 py-3.5 text-ink-soft">{r.best}</td>
              <td class="px-5 py-3.5 font-medium text-vermilion">
                {"$".repeat(r.cost)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-soft">Cost is relative: one to three dollar signs for a mid-range traveller.</p>
  </div>
</section>
