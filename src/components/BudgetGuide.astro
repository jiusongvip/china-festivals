---
const tiers = [
  {
    label: "Budget",
    range: "$40-80",
    per: "a day",
    detail: "Hostels, street food, second-class high-speed rail. Doable everywhere except Harbin and Shanghai in peak season.",
  },
  {
    label: "Comfort",
    range: "$80-150",
    per: "a day",
    detail: "Mid-range hotels, sit-down restaurants, and first-class rail. The sweet spot for most festival trips.",
  },
  {
    label: "Premium",
    range: "$200+",
    per: "a day",
    detail: "Upscale hotels, private drivers, and guides. Worth it over Spring Festival when logistics get hard.",
  },
];
---

<section id="budget" class="border-t border-hairline">
  <div class="container-px section-pad">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      What a festival trip costs
    </h2>
    <p class="mt-3 max-w-[60ch] text-ink-soft leading-relaxed">
      Rough daily budgets per person, excluding international flights. Adjust for the
      city and the season.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {tiers.map((t) => (
        <div class="rounded-field border border-hairline bg-white/60 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">{t.label}</p>
          <p class="mt-2 font-display text-4xl font-semibold text-ink">
            {t.range}
            <span class="ml-1 text-base font-normal text-ink-soft">{t.per}</span>
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{t.detail}</p>
        </div>
      ))}
    </div>

    <div class="mt-6 rounded-field border border-vermilion/20 bg-vermilion-soft px-5 py-4">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-vermilion-dark">Seasonal markup</p>
      <p class="mt-1 text-sm leading-relaxed text-ink">
        Over Spring Festival and Golden Week, flights and hotels often double or triple.
        Ethnic festival towns like Xishuangbanna and Harbin spike too. Book two to three
        months out, or travel just outside the peak window.
      </p>
    </div>
  </div>
</section>
