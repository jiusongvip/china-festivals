---
const navLinks = [
  { href: "#finder", label: "Festival Finder" },
  { href: "#calendar", label: "2027 Calendar" },
  { href: "#festivals", label: "Festivals" },
  { href: "#cities", label: "Where to Go" },
  { href: "#tips", label: "Travel Tips" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-paper/90 backdrop-blur-md">
  <nav class="container-px flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <span class="grid h-8 w-8 place-items-center rounded-full bg-vermilion">
        <span class="h-3.5 w-3.5 rounded-full border-2 border-paper"></span>
      </span>
      <span class="font-display text-xl font-semibold leading-none tracking-tight">China Festivals</span>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-ink-soft transition-colors hover:text-vermilion"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <a href="#finder" class="btn-primary hidden shrink-0 lg:inline-flex">Find my festival</a>

    <details class="group relative lg:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-hairline bg-paper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="text-ink">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-field border border-hairline bg-paper p-2 shadow-sm">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="block rounded-field px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-paper-deep hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
        <a href="#finder" class="btn-primary mt-2 w-full">Find my festival</a>
      </div>
    </details>
  </nav>
</header>
