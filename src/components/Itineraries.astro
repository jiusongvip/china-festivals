---
const itineraries = [
  {
    title: "Spring Festival",
    days: "5 days",
    city: "Beijing, then Xi'an",
    slug: "spring-festival",
    plan: [
      "Arrive, wander Qianmen for new-year shopping",
      "Ditan temple fair for folk shows and street snacks",
      "Forbidden City by day, check holiday hours first",
      "High-speed rail to Xi'an for the city-wall lanterns",
      "Fly home from Xi'an",
    ],
  },
  {
    title: "Water Splashing",
    days: "3 days",
    city: "Xishuangbanna",
    slug: "water-splashing-festival",
    plan: [
      "Arrive in Jinghong, night market at Gaozhuang",
      "The main water fight and dragon-boat races",
      "Manting Park, release a sky lantern, fly out",
    ],
  },
  {
    title: "Mid-Autumn",
    days: "3 days",
    city: "Guilin and Yangshuo",
    slug: "mid-autumn-festival",
    plan: [
      "Arrive, buy mooncakes at a night market",
      "Li River cruise by day, moon over the karst at night",
      "Yangshuo countryside in the morning, fly out",
    ],
  },
];
---

<section id="itineraries" class="border-t border-hairline bg-paper-deep/40">
  <div class="container-px section-pad">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Three festival itineraries
    </h2>
    <p class="mt-3 max-w-[60ch] text-ink-soft leading-relaxed">
      Ready-made plans for the festivals people ask about most.
    </p>

    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {itineraries.map((it) => (
        <a
          href={`#${it.slug}`}
          class="group flex flex-col rounded-field border border-hairline bg-white/60 p-6 transition-colors duration-200 hover:border-vermilion"
        >
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display text-2xl font-semibold text-ink group-hover:text-vermilion">
              {it.title}
            </p>
            <span class="text-sm font-medium text-vermilion">{it.days}</span>
          </div>
          <p class="mt-1 text-sm text-ink-soft">{it.city}</p>
          <ol class="mt-4 space-y-2.5 border-t border-hairline pt-4">
            {it.plan.map((step, i) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-vermilion-soft text-xs font-semibold text-vermilion-dark">
                  {i + 1}
                </span>
                {step}
              </li>
            ))}
          </ol>
        </a>
      ))}
    </div>
  </div>
</section>
