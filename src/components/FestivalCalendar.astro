---
import { festivals, monthGuide, type MonthInfo } from "../data/festivals";

const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

// group festivals by month, keep only months with festivals
const byMonth: { month: number; name: string; items: typeof festivals; info: MonthInfo }[] = [];
for (let m = 1; m <= 12; m++) {
  const items = festivals
    .filter((f) => f.month === m)
    .sort((a, b) => a.name.localeCompare(b.name));
  if (items.length > 0) {
    byMonth.push({ month: m, name: MONTH_NAMES[m - 1], items, info: monthGuide[m] });
  }
}

const key2027 = [
  { name: "Spring Festival", date: "Feb 6" },
  { name: "Lantern Festival", date: "Feb 20" },
  { name: "Qingming", date: "Apr 5" },
  { name: "Dragon Boat", date: "Jun 9" },
  { name: "Qixi", date: "Aug 8" },
  { name: "Mid-Autumn", date: "Sep 15" },
  { name: "Double Ninth", date: "Oct 8" },
  { name: "National Day", date: "Oct 1" },
];
---

<section id="calendar" class="border-t border-hairline bg-paper-deep/40">
  <div class="container-px section-pad">
    <div class="max-w-[60ch]">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        China festival calendar 2026
      </h2>
      <p class="mt-3 text-ink-soft leading-relaxed">
        Lunar festivals shift year to year. These are the 2026 Gregorian dates, with the
        lunar date shown where it applies.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        byMonth.map((g) => (
          <div class="rounded-field border border-hairline bg-white/60 p-6">
            <p class="font-display text-xl font-semibold text-vermilion">{g.name}</p>
            <div class="mt-2 space-y-1 text-sm text-ink-soft">
              <p>Weather: <span class="text-ink">{g.info.weather}</span></p>
              <p>Crowds: <span class="text-ink">{g.info.crowd}</span></p>
              <p>Verdict: <span class="font-medium text-vermilion">{g.info.verdict}</span></p>
            </div>
            <ul class="mt-4 space-y-4">
              {g.items.map((f) => (
                <li class="border-t border-hairline pt-4 first:border-t-0 first:pt-0">
                  <a href={`#${f.slug}`} class="group block">
                    <span class="font-medium text-ink group-hover:text-vermilion">
                      {f.name}
                    </span>
                    <span class="ml-1 text-ink-soft">· {f.nameZh}</span>
                    <span class="mt-1 block text-sm text-ink-soft">
                      {f.date2026}
                      {f.lunarDate ? ` · ${f.lunarDate}` : ""}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-field border border-hairline bg-white/60 p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="font-display text-xl font-semibold text-ink">Already planning 2027?</h3>
        <span class="text-xs text-ink-soft">Early estimates, confirmed each January</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {key2027.map((k) => (
          <span class="inline-flex items-baseline gap-1.5 text-sm">
            <span class="font-medium text-ink">{k.name}</span>
            <span class="text-vermilion">{k.date}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
