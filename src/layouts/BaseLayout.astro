---
import "../styles/global.css";
import cormorant600 from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url";
import outfit400 from "@fontsource/outfit/files/outfit-latin-400-normal.woff2?url";
import outfit500 from "@fontsource/outfit/files/outfit-latin-500-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = "https://www.festivals-china.com",
  schemas = [],
} = Astro.props;
const ogImage = "https://www.festivals-china.com/og.jpg";
const fontPreloads = [
  { href: cormorant600, type: "font/woff2" },
  { href: outfit400, type: "font/woff2" },
  { href: outfit500, type: "font/woff2" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js): deferred until first interaction or idle to keep TBT/LCP clean -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-92D8HDFTQM");

      (function loadAnalytics() {
        var GA_ID = "G-92D8HDFTQM";
        var loaded = false;
        var load = function () {
          if (loaded) return;
          loaded = true;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
          document.head.appendChild(s);
        };
        var events = ["pointerdown", "keydown", "touchstart", "scroll"];
        var onFirst = function () {
          events.forEach(function (e) {
            window.removeEventListener(e, onFirst, { passive: true });
          });
          load();
        };
        events.forEach(function (e) {
          window.addEventListener(e, onFirst, { passive: true, once: true });
        });
        if (document.readyState === "complete") {
          setTimeout(load, 3000);
        } else {
          window.addEventListener("load", function () {
            setTimeout(load, 3000);
          });
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="China Festivals" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {fontPreloads.map((f) => (
      <link rel="preload" as="font" type={f.type} href={f.href} crossorigin="anonymous" />
    ))}

    {
      schemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body>
    <slot />
  </body>
</html>
