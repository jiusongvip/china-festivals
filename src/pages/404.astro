---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "404 - Page Not Found | China Festivals";
const description =
  "The page you are looking for does not exist or has moved. Explore the complete 2027 China festival calendar with dates, traditions and celebration tips.";
---
<BaseLayout title={title} description={description}>
  <main class="container-px flex min-h-[72vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-[6.5rem] leading-none text-vermilion sm:text-[8.5rem]">404</p>
    <h1 class="font-display mt-6 text-3xl sm:text-4xl">This page has drifted away</h1>
    <p class="mt-4 max-w-md text-ink-soft">
      The page you are looking for doesn&rsquo;t exist or has moved. Head back to discover all 22 China
      festivals &mdash; dates, traditions and the best places to celebrate in 2027.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/#calendar" class="btn-ghost">View 2027 calendar</a>
    </div>
  </main>
</BaseLayout>
