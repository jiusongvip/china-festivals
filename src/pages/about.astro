---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About China Festivals",
    url: "https://www.festivals-china.com/about/",
    mainEntity: {
      "@type": "Organization",
      name: "China Festivals",
      url: "https://www.festivals-china.com",
      email: "hello@festivals-china.com",
      sameAs: [
        "https://www.yunnan-province.com/",
        "https://www.guangxi-province.com/",
        "https://www.tibet-lhasa-potala.com/",
        "https://www.xi-an-china.com/",
        "https://www.china-attractions-in-beijing.com/",
      ],
    },
  },
];
---

<BaseLayout
  title="About China Festivals: Who Writes This Guide"
  description="Who is behind China Festivals: travel editors, first-hand visits, official sources like the State Council and NIA, and how we keep 22 festival guides current."
  canonical="https://www.festivals-china.com/about/"
  schemas={schemas}
>
  <Nav />
  <main>
    <section class="border-t border-hairline bg-paper-deep/40">
      <div class="container-px section-pad">
        <div class="max-w-[68ch]">
          <h1 class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
            About China Festivals
          </h1>
          <p class="mt-5 leading-relaxed text-ink-soft">
            China Festivals is an independent editorial guide to the 22 celebrations
            worth planning a trip around, from Spring Festival to the Water Splashing
            Festival. It is written and maintained by travel editors who have attended
            the festivals they cover, and it is refreshed every January when the new
            holiday calendar and lunar dates are confirmed.
          </p>

          <h2 class="mt-10 font-display text-3xl font-semibold tracking-tight text-ink">
            How we research
          </h2>
          <p class="mt-3 leading-relaxed text-ink-soft">
            Every festival page is built from three layers: first-hand visits (temple
            fairs in Beijing, the Shoton thangka unveiling in Lhasa, ice parks in
            Harbin), official announcements, and on-the-ground checks with local
            operators. Dates follow the State Council's official holiday arrangement,
            and lunar-to-Gregorian conversions are cross-checked each January.
          </p>

          <h2 class="mt-10 font-display text-3xl font-semibold tracking-tight text-ink">
            Editorial standards
          </h2>
          <ul class="mt-3 space-y-2 leading-relaxed text-ink-soft">
            <li>· No sponsored placements, no paid links, no affiliate commissions.</li>
            <li>· Where we link to our own city guides, we say so.</li>
            <li>· Crowd levels, costs, and logistics reflect the most recent festival season.</li>
            <li>· Corrections are welcome and credited, email us and we will update the page.</li>
          </ul>

          <h2 class="mt-10 font-display text-3xl font-semibold tracking-tight text-ink">
            Sources we rely on
          </h2>
          <ul class="mt-3 space-y-2 leading-relaxed text-ink-soft">
            <li>
              ·
              <a
                href="https://www.gov.cn/"
                target="_blank"
                rel="noopener"
                class="font-medium text-vermilion hover:underline"
              >The State Council</a>
              — official public holiday arrangements.
            </li>
            <li>
              ·
              <a
                href="https://www.nia.gov.cn/"
                target="_blank"
                rel="noopener"
                class="font-medium text-vermilion hover:underline"
              >National Immigration Administration</a>
              — visa-free and transit policies.
            </li>
            <li>
              ·
              <a
                href="https://ich.unesco.org/en/RL/spring-festival-social-practices-of-the-chinese-people-in-celebration-of-traditional-new-year-02126"
                target="_blank"
                rel="noopener"
                class="font-medium text-vermilion hover:underline"
              >UNESCO</a>
              — Spring Festival inscription on the Representative List of the Intangible
              Cultural Heritage of Humanity (2024).
            </li>
          </ul>

          <h2 class="mt-10 font-display text-3xl font-semibold tracking-tight text-ink">
            Contact
          </h2>
          <p class="mt-3 leading-relaxed text-ink-soft">
            Questions, corrections, or partnership requests? Email
            <a
              href="mailto:hello@festivals-china.com"
              class="font-medium text-vermilion hover:underline"
            >hello@festivals-china.com</a>
            — we read everything and reply to substantive mail.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
